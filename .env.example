# 复制为环境变量或 CI secrets 使用，不要把真实密钥写入 conf/config.ini

# AI 结果解读（DeepSeek/OpenAI 等兼容接口）
AI_API_KEY=
ZQ_AI_BASE_URL=https://api.deepseek.com
ZQ_AI_MODEL=deepseek-chat

# 数据库 / 中间件敏感配置（前缀 ZQ_ + 配置段大写 + 配置项大写）
ZQ_MYSQL_PASSWORD=
ZQ_REDIS_PASSWORD=
ZQ_MONGODB_PASSWORD=
ZQ_SSH_PASSWORD=
ZQ_CLICKHOUSE_PASSWORD=

# 飞书机器人 webhook 与加签密钥
ZQ_AI_FEISHU_WEBHOOK=
ZQ_AI_FEISHU_SECRET=
